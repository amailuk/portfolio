---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const featured = (await getCollection('work'))
  .filter((w) => w.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const services = [
  {
    num: '01',
    title: 'Data collection & M&E systems',
    body: 'Survey design and digital data collection that survives the field — KoboToolbox, SurveyCTO, and the data-management routines that keep programs measurable.',
  },
  {
    num: '02',
    title: 'Dashboards & reporting',
    body: 'Power BI, Excel, and SQL pipelines that turn raw operational records into visuals a manager reads in ten seconds.',
  },
  {
    num: '03',
    title: 'Analysis & custom data tools',
    body: 'Statistical analysis with honest tests and stated caveats — plus complete custom tools (Streamlit + PostgreSQL) when a spreadsheet stops being enough.',
  },
  {
    num: '04',
    title: 'Training & capacity building',
    body: 'Coaching teams on data practice: from survey discipline to dashboard literacy. Former Head of Training — materials, mentoring, and measurable outcomes.',
  },
  {
    num: '05',
    title: 'Technical writing & documentation',
    body: 'Reports, policy briefs, training materials, and data documentation — analysis that reads clearly outside the analytics team.',
  },
];
---
<Layout title="Amailuk Joseph Richard — M&E and data analytics consultant">
  <section class="hero">
    <div class="container">
      <span class="hero-kicker">M&E · Data analytics · Kenya & remote</span>
      <h1>Helping NGOs and SMEs <em>measure what matters</em> — and act on it.</h1>
      <p class="lead">
        I'm Amailuk Joseph Richard, a monitoring-and-evaluation and data analytics consultant.
        I design the data collection, build the dashboards, run the analysis, and — when
        spreadsheets stop being enough — build the data systems themselves.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/#work">See the work</a>
        <a class="btn btn-ghost" href="/#contact">Request a quote</a>
      </div>
    </div>
  </section>

  <section class="section" id="services">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Services</span>
        <h2>What you can hire me for</h2>
        <p>Five service lines, one through-line: evidence-based decisions, delivered in a form your team will actually use.</p>
      </div>
      <div class="services-grid">
        {services.map((s) => (
          <div class="service-card">
            <span class="num">{s.num}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" id="work">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Case studies</span>
        <h2>Deep dives, honest numbers</h2>
        <p>Each one a real engagement-shaped problem: context, method, findings, and recommendations — the numbers stated exactly as the artifacts support them.</p>
      </div>
      <div class="work-grid">
        {featured.map((w) => (
          <a class="work-card" href={`/work/${w.id}/`}>
            <img class="cover" src={w.data.cover} alt={w.data.title} loading="lazy" />
            <div class="body">
              <span class="tag">{w.data.category}</span>
              <h3>{w.data.title}</h3>
              <p>{w.data.description}</p>
              <div class="card-metrics">
                {w.data.metrics.slice(0, 3).map((m) => (
                  <div><strong>{m.value}</strong>{m.label}</div>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
      <p class="coming-note">More work in the vault — smaller analyses and dashboard builds — is being added next.</p>
    </div>
  </section>

  <section class="section alt" id="about">
    <div class="container">
      <div class="section-head">
        <span class="kicker">About</span>
        <h2>Evidence-based, end to end</h2>
      </div>
      <div class="placeholder-panel">
        <p>
          The full about section — professional background, certifications, and the tool stack —
          plus a downloadable CV are on their way.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Contact</span>
        <h2>Let's talk about your data</h2>
        <p>Tell me what you're trying to measure or decide, and I'll tell you what it takes. Free 30-minute consult.</p>
      </div>
      <div class="contact-grid">
        <a class="contact-card" href="mailto:amailukj@gmail.com">
          <div class="label">Email</div>
          <div class="value">amailukj@gmail.com</div>
        </a>
        <a class="contact-card" href="tel:+254715888927">
          <div class="label">Phone / WhatsApp</div>
          <div class="value">+254 715 888 927</div>
        </a>
        <a class="contact-card" href="https://github.com/amailuk" rel="noopener">
          <div class="label">GitHub</div>
          <div class="value">github.com/amailuk</div>
        </a>
      </div>
    </div>
  </section>
</Layout>
